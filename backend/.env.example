# Server Configuration
PORT=4000
NODE_ENV=development

# JWT Secret (generate a strong one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=generate_a_strong_secret_key_here

# Database Configuration
# Para desarrollo: usa SQLite (SQLITE_PATH)
# Para producción (Railway): usa PostgreSQL (DATABASE_URL - se asigna automáticamente)
# Para desarrollo local contra Railway: usa DATABASE_PUBLIC_URL
SQLITE_PATH=./database.db
DATABASE_URL=postgresql://user:password@localhost:5432/crm_infiniguard
DATABASE_PUBLIC_URL=postgresql://user:password@public-host.railway.app:5432/railway

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Stripe Webhook — Internal Secret
# DEBE coincidir exactamente con WEBHOOK_INTERNAL_SECRET en el serverless de Vercel
# Genera uno: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_INTERNAL_SECRET=cambia_esto_por_el_mismo_valor_que_en_vercel

